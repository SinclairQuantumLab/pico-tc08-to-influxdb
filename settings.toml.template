# Settings configuration file for pico-tc08-to-influxdb app
# Copy this file to settings.toml and update the values for the TC-08 session.
# See README.md for detail.

# TC-08 Serial number
sn = "AC161/246"

# Measurement period in seconds
period_s = 15

# Enable logging to local files
enable_logging = true

# Uploading to InfluxDB
# Enable upload
enable_influxdb_upload = true
# InfluxDB measurement name
measurement = "Pico_TC08"

# Names of log files
dirname_log = "./logs/"
fname_log_meas = "temp.log"
fname_log_err = "error.log"

# TC08 logger channels to activate, thermocouple types, & names assigned in InfluxDB
# Temperature thermocouple types: B, E, J, K, N, R, S, T.
# PicoSDK also accepts SPACE to disable a channel and X for voltage reading mode,
# but this app currently logs temperature fields only.
# Remove a [channels.N] block to disable that channel.
[channels.1]
type = "K"
name = "Ch1"

[channels.2]
type = "K"
name = "Ch2"

[channels.3]
type = "K"
name = "Ch3"

[channels.4]
type = "K"
name = "Ch4"

[channels.5]
type = "K"
name = "Ch5"

[channels.6]
type = "K"
name = "Ch6"

[channels.7]
type = "K"
name = "Ch7"

[channels.8]
type = "K"
name = "Ch8"
